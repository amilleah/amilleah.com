<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>guestbook — amilleah.com</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/guestbook.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <main class="auto-padding">
    <div class="guestbook-header">
      <h1>guestbook</h1>
      <p class="--muted">leave a note</p>
    </div>

    <form class="guestbook-form" name="guestbook" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="guestbook">
      <p hidden><input name="bot-field"></p>
      <div class="form-row">
        <input type="text" name="name" placeholder="name" required autocomplete="off">
        <button type="submit">sign</button>
      </div>
      <textarea name="message" placeholder="leave a note" rows="3" required maxlength="3000"></textarea>
      <small class="word-count">200 words left</small>
    </form>

    <div id="guestbook-log" class="guestbook-log"></div>
  </main>
  <script type="module" src="/guestbook/guestbook.js"></script>
  <% if (guestbookId) { %>
  <script>
    (async () => {
      const logEl = document.getElementById('guestbook-log');
      try {
        const res   = await fetch('https://api.github.com/gists/<%= guestbookId %>', {
          headers: { Accept: 'application/vnd.github+json' }
        });
        const gist  = await res.json();
        const file  = gist.files['guestbook.json'];
        if (!file) return;
        const entries = JSON.parse(file.content);
        logEl.innerHTML = entries.map(entry =>
          `<p><span class="--muted" style="margin-right:2em">${entry.timestamp}</span>${entry.name}: ${entry.body}</p>`
        ).join('<hr>');
      } catch {}
    })();
  </script>
  <% } %>
</body>
</html>
