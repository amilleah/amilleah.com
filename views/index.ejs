<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>amilleah.com</title>
  <meta name="description" content="Amilleah is a cognitive neuroscientist and linguist.">
  <meta name="author" content="Amilleah Rodriguez">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/guestbook.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate" type="application/rss+xml" title="amilleah" href="/feed.xml">
</head>

<body>
  <main class="container">

    <%- include('_sidebar', { projects, cvUpdated }) %>

    <section class="flex-right">
      <% if (gistId) { %>
      <div id="feed" class="auto-padding"></div>
      <% } %>
    </section>

  </main>

  <script>
    const right = document.querySelector('.flex-right');
    const defaultHtml = right.innerHTML;
    let current = null;
    const loadedScripts = new Set();

    <% if (gistId) { %>
    async function loadFeed() {
      const feedEl = document.getElementById('feed');
      if (!feedEl) return;
      try {
        const res  = await fetch('https://api.github.com/gists/<%= gistId %>', {
          headers: { Accept: 'application/vnd.github+json' }
        });
        const gist = await res.json();
        const file = gist.files['rss.json'];
        if (!file) return;
        const items = JSON.parse(file.content);
        feedEl.innerHTML = items.map(item =>
          `<p><span class="--muted" style="margin-right:2em">${item.timestamp}</span>${item.body}</p>`
        ).join('<hr>');
      } catch {}
    }
    <% } %>

    function routeFromPath(pathname) {
      const path = pathname.replace(/\/+$/, '') || '/';
      if (path === '/guestbook') return { type: 'guestbook' };
      const projectMatch = path.match(/^\/projects\/([^/]+)$/);
      if (projectMatch) return { type: 'project', slug: projectMatch[1] };
      return { type: 'default' };
    }

    function clear({ push = true } = {}) {
      right.innerHTML = defaultHtml;
      current = null;
      document.dispatchEvent(new CustomEvent('panel:cleared'));
      <% if (gistId) { %>loadFeed();<% } %>
      if (push) history.pushState({}, '', '/');
    }

    async function loadProject(link, { push = true } = {}) {
      const slug       = link.dataset.slug;
      const fragmentUrl = slug === 'guestbook' ? '/guestbook/index.html' : `/projects/${slug}/index.html`;
      const prettyUrl   = slug === 'guestbook' ? '/guestbook' : `/projects/${slug}`;

      const res  = await fetch(fragmentUrl);
      const html = await res.text();
      const doc  = new DOMParser().parseFromString(html, 'text/html');
      right.innerHTML = (doc.querySelector('main') ?? doc.body).innerHTML;

      doc.querySelectorAll('link[rel="stylesheet"]').forEach(el => {
        const href = el.getAttribute('href');
        if (!document.querySelector(`link[href="${href}"]`)) {
          const s = document.createElement('link');
          s.rel = 'stylesheet'; s.href = href;
          document.head.appendChild(s);
        }
      });

      doc.querySelectorAll('script[type="module"][src]').forEach(el => {
        const src = el.getAttribute('src');
        if (!loadedScripts.has(src)) {
          loadedScripts.add(src);
          const s = document.createElement('script');
          s.type = 'module'; s.src = src;
          document.body.appendChild(s);
        }
      });

      document.dispatchEvent(new CustomEvent('panel:loaded', { detail: slug }));

      current = slug;
      if (push) history.pushState({}, '', prettyUrl);
    }

    function loadPdf(link) {
      document.dispatchEvent(new CustomEvent('panel:cleared'));
      right.innerHTML = `<embed src="${link.href}" type="application/pdf" style="width:100%;height:100%">`;
      current = 'cv';
    }

    document.querySelector('a[data-pdf]').addEventListener('click', e => {
      if (window.matchMedia('(max-width: 43em)').matches) return;
      e.preventDefault();
      current === 'cv' ? clear() : loadPdf(e.currentTarget);
    });

    document.querySelectorAll('a[data-slug]').forEach(link => {
      link.addEventListener('click', async e => {
        e.preventDefault();
        current === link.dataset.slug ? clear() : await loadProject(link);
      });
    });

    window.addEventListener('popstate', () => {
      const route = routeFromPath(location.pathname);
      if (route.type !== 'default') {
        const slugAttr = route.type === 'guestbook' ? 'guestbook' : route.slug;
        const link = document.querySelector(`a[data-slug="${slugAttr}"]`);
        if (link) { loadProject(link, { push: false }); return; }
      }
      clear({ push: false });
    });

    const bookLink = document.querySelector('.book-link');
    const bookEl   = bookLink?.querySelector('.book');
    if (bookLink && bookEl) {
      bookLink.addEventListener('mouseenter', () => {
        bookEl.style.animationPlayState = 'paused';
      });
      bookLink.addEventListener('mouseleave', () => {
        bookEl.style.animationPlayState = '';
      });
    }

    <% if (gistId) { %>loadFeed();<% } %>

    const initialRoute = routeFromPath(location.pathname);
    if (initialRoute.type !== 'default') {
      const slugAttr = initialRoute.type === 'guestbook' ? 'guestbook' : initialRoute.slug;
      const link = document.querySelector(`a[data-slug="${slugAttr}"]`);
      if (link) loadProject(link, { push: false });
    }

  </script>
</body>
</html>
