    <section class="flex-left y-scrollable auto-padding">
      <h1>Amilleah <span class="--muted">/əˈmɪliə/</span> is a cognitive neuroscientist and linguist.</h1>
      <p>
        Hi! I'm an incoming Linguistics PhD student at the University of Michigan, where I'll be working with Prof. Jon Brennan. I study how we represent and use context during real-time language processing. I use M/EEG and neural language models to investigate these topics. Previously, I worked with Prof. Liina Pylkkänen at the NYU Neurolinguistics Lab.
      </p>
      <p>
        I am often developing open-source projects, working with time-series data, writing my newsletter, and updating this website!
      </p>

      <p class="links">
        Contact me:
        <a href="mailto:amilleah@umich.edu">amilleah@umich.edu</a>,
        <a href="mailto:hey@amilleah.com">hey@amilleah.com</a>,
        <a href="https://are.na/amilleah">are.na</a>,
        <a href="https://github.com/amilleah">github</a>,
        <a href="https://inprogress.works/archive/amilleah">inprogress.works</a>,
        <a href="https://amilleah.substack.com">substack</a>
      </p>

      <p class="section-gap">research</p>
      <hr>
      <a class="row" href="/research/amilleahrodriguez_cv.pdf" data-pdf target="_blank">
        <span class="row-name">curriculum vitae</span>
        <span class="row-desc"></span>
        <span class="row-date"><%= cvUpdated %></span>
      </a>

      <p class="section-gap">projects</p>
      <hr>
      <%_ projects.forEach(function(project) { _%>
      <a class="row" href="/<%= project.slug %>" data-slug="<%= project.slug %>">
        <span class="row-name"><%= project.slug %></span>
        <span class="row-desc"><%= project.description %></span>
        <span class="row-date"><%= project.date %></span>
      </a>
      <%_ }); _%>

      <%_ if (typeof pages !== 'undefined' && pages.length) { _%>
      <p class="section-gap">pages</p>
      <hr>
      <%_ pages.forEach(function(page) { _%>
      <%_ if (page.url) { _%>
      <a class="row page" href="<%= page.url %>" target="_blank" rel="noopener">
        <span class="row-name"><%= page.slug %> <span class="row-ext" aria-hidden="true">↗</span></span>
        <span class="row-desc"><%= page.description || '' %></span>
      </a>
      <%_ } else { _%>
      <a class="row page" href="/<%= page.slug %>" data-slug="<%= page.slug %>">
        <span class="row-name"><%= page.slug %></span>
        <span class="row-desc"><%= page.description || '' %></span>
      </a>
      <%_ } _%>
      <%_ }); _%>
      <%_ } _%>

      <%_ if (typeof sites !== 'undefined' && sites.length) { _%>
      <p class="section-gap">sites</p>
      <hr>
      <%_ sites.forEach(function(site) { _%>
      <a class="row site" href="<%= site.url %>" target="_blank" rel="noopener">
        <span class="row-name"><%= site.name %> <span class="row-ext" aria-hidden="true">↗</span></span>
        <%_ if (site.description) { _%><span class="row-desc"><%= site.description %></span><%_ } _%>
      </a>
      <%_ }); _%>
      <%_ } _%>

      <a class="book-link" href="/guestbook" data-slug="guestbook">
        <div class="book">
          <div class="cover"></div>
          <div class="back"></div>
          <div class="spine"></div>
          <div class="pages"></div>
          <div class="top-face"></div>
          <div class="bottom-face"></div>
        </div>
      </a>

    </section>
