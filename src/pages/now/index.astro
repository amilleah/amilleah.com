---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/utils";
import TagPill from "../../components/TagPill.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const collection = await getCollection("now");
const posts = collection.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const normalizeTags = (tags: unknown) =>
  Array.isArray(tags) ? tags : tags ? [tags] : [];

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/public/images/now/*.{jpg,jpeg,png,webp}",
);
---

<Layout title="now" description="right now.">
  <main
    class="grid gap-[calc(var(--space))] md:grid-cols-[2fr_5fr]"
    style="--space: max(1vw, 3px);"
  >
    <section class="space-y-6">
      <header class="space-y-2">
        <h1 class="text-lg font-medium tracking-tight">now</h1>
        <p class="text-sm text-zinc-400">
          inspired by <a class="whitespace-nowrap hover:underline underline-offset-2 decoration-zinc-300 hover:decoration-zinc-500" href="https://nownownow.com"
            >nownownow.com<span class="hover:underline"></span></a>
        <br />
        </p>
      </header>
      <div class="h-px w-16 bg-zinc-200"></div>
      <p class="text-zinc-500">
          you can find weekly updates on <a class="whitespace-nowrap hover:underline underline-offset-2 decoration-zinc-300 hover:decoration-zinc-500" href="https://inprogress.works"
          >inprogress.works<span class="hover:underline"></span></a>!
      <p/> 
      <p class="tag-filter-indicator text-sm text-zinc-400 hidden"></p>
      <ul class="flex flex-col gap-1.5 md:px-0">
        {
          posts.map((post) => {
            const tags = normalizeTags(post.data.tags);
            return (
              <li class="now-post" data-tags={tags.join(",")} data-post-slug={post.slug}>
                <a
                  href={`/now?post=${encodeURIComponent(post.slug)}`}
                  class="now-post-link group grid gap-1"
                  data-post-link={post.slug}
                >
                  <span class="text-xs text-zinc-500">
                    {formatDate(post.data.date)}
                  </span>
                  <span class="group-hover:underline">{post.data.title}</span>
                  {
                    tags.length ? (
                      <span class="flex flex-wrap gap-1">
                        {tags.map((tag) => (
                          <TagPill
                            tag={tag}
                            href={`/now?tag=${encodeURIComponent(tag)}`}
                            dataTag={tag}
                          />
                        ))}
                      </span>
                    ) : null
                  }
                </a>
              </li>
            );
          })
        }
      </ul>
    <br />
    </section>
    <section id="now-right-panel">
      <section class="justified-gallery" id="photoswipe">
        {
          Object.entries(images).map(async ([_path, image], index) => {
            const { default: imageData } = await image();
            return (
              <a
                style={`--width: ${imageData.width}; --height: ${imageData.height};`}
                href={imageData.src}
                data-fancybox="gallery"
              >
                <Image
                  format="webp"
                  src={imageData}
                  alt=""
                  height={400}
                  loading={index < 20 ? "eager" : "lazy"}
                />
              </a>
            );
          })
        }
        <footer class="grid-attribution text-xs text-zinc-400">
          photo grid based on
          <a
            class="hover:underline underline-offset-2 decoration-zinc-300 hover:decoration-zinc-500"
            href="https://github.com/evadecker/astro-photo-grid"
          >
            astro-photo-grid.
          </a>
        </footer>
      </section>
      <article id="selected-post-panel" class="space-y-4 px-1 py-2" style="display: none;">
        <a
          id="selected-post-back"
          href="/now"
          class="inline-flex items-center gap-1 text-sm text-zinc-500 hover:text-zinc-700 hover:underline underline-offset-2"
          aria-label="Back to photos"
        >
          <span aria-hidden="true">←</span>
          <span>photos</span>
        </a>
        <div id="selected-post-content"></div>
      </article>
    </section>
  </main>

  <div class="hidden" aria-hidden="true">
    {
      posts.map(async (post) => {
        const { Content } = await post.render();
        return (
          <template data-post-template={post.slug}>
            <article class="space-y-4">
              <header class="space-y-2">
                <h2 class="text-lg font-medium tracking-tight">{post.data.title}</h2>
                <p class="text-sm text-zinc-500">{formatDate(post.data.date)}</p>
              </header>
              <Content />
            </article>
          </template>
        );
      })
    }
  </div>
</Layout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  Fancybox.bind("[data-fancybox]", {
    theme: "auto",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        display: {
          left: [],
          middle: [],
          right: ["close"],
        },
      },
      transition: "slide",
    },
  });
</script>

<script>
  const photoPanel = document.getElementById("photoswipe");
  const postPanel = document.getElementById("selected-post-panel");
  const postContent = document.getElementById("selected-post-content");
  const backLink = document.getElementById("selected-post-back");

  const showPhotos = () => {
    if (photoPanel) {
      photoPanel.style.display = "";
    }
    if (postPanel) {
      postPanel.style.display = "none";
    }
  };

  const showPost = () => {
    if (photoPanel) {
      photoPanel.style.display = "none";
    }
    if (postPanel) {
      postPanel.style.display = "";
    }
  };

  const setPostStateFromParams = () => {
    const params = new URLSearchParams(window.location.search);
    const activeSlug = params.get("post");
    const template = activeSlug
      ? document.querySelector(
          `template[data-post-template="${CSS.escape(activeSlug)}"]`,
        )
      : null;

    document.querySelectorAll(".now-post").forEach((item) => {
      const isActive = item.getAttribute("data-post-slug") === activeSlug;
      item.classList.toggle("active", isActive);
    });

    if (!activeSlug || !template || !photoPanel || !postPanel || !postContent) {
      if (photoPanel && postPanel && postContent) {
        postContent.innerHTML = "";
        showPhotos();
      }
      return;
    }

    postContent.innerHTML = template.innerHTML;
    showPost();
  };

  const pushPostParam = (slug: string) => {
    const url = new URL(window.location.href);
    url.searchParams.set("post", slug);
    history.pushState({}, "", `${url.pathname}?${url.searchParams.toString()}`);
    setPostStateFromParams();
  };

  const clearPostParam = () => {
    const url = new URL(window.location.href);
    url.searchParams.delete("post");
    const query = url.searchParams.toString();
    history.pushState({}, "", query ? `${url.pathname}?${query}` : url.pathname);
    setPostStateFromParams();
  };

  document.querySelectorAll("[data-post-link]").forEach((link) => {
    link.addEventListener("click", (event: Event) => {
      if (!(event instanceof MouseEvent)) {
        return;
      }
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      event.preventDefault();
      const slug = link.getAttribute("data-post-link");
      if (slug) {
        pushPostParam(slug);
      }
    });
  });

  if (backLink) {
    backLink.addEventListener("click", (event) => {
      event.preventDefault();
      clearPostParam();
    });
  }

  setPostStateFromParams();
  document.addEventListener("astro:page-load", setPostStateFromParams);
  window.addEventListener("popstate", setPostStateFromParams);
</script>

<script>
  const applyTagFilter = () => {
    const params = new URLSearchParams(window.location.search);
    const activeTag = params.get("tag");
    const indicator = document.querySelector(".tag-filter-indicator");

    document.querySelectorAll(".now-post").forEach((item) => {
      item.classList.remove("hidden");
    });

    document.querySelectorAll("[data-tag]").forEach((tagLink) => {
      tagLink.classList.remove("bg-zinc-100", "text-zinc-600");
    });

    if (!activeTag) {
      if (indicator) {
        indicator.classList.add("hidden");
        indicator.textContent = "";
      }
      return;
    }

    const normalizedTag = activeTag.toLowerCase();

    if (indicator) {
      indicator.innerHTML = `filter: <span class="rounded-full border border-zinc-200 px-2 py-0.5 text-[11px] text-zinc-400 inline-flex items-center gap-1"><span>${activeTag}</span><a class="text-zinc-500 hover:text-zinc-700 no-underline hover:no-underline" href="/now" aria-label="Clear tag filter">×</a></span>`;
      indicator.classList.remove("hidden");
    }

    document.querySelectorAll(".now-post[data-tags]").forEach((item) => {
      const tags = (item.getAttribute("data-tags") || "")
        .split(",")
        .map((tag) => tag.trim().toLowerCase())
        .filter(Boolean);
      const isMatch = tags.includes(normalizedTag);
      item.classList.toggle("hidden", !isMatch);
    });

    document.querySelectorAll("[data-tag]").forEach((tagLink) => {
      const tag = (tagLink.getAttribute("data-tag") || "").toLowerCase();
      if (tag === normalizedTag) {
        tagLink.classList.add("bg-zinc-100", "text-zinc-600");
      }
    });
  };

  applyTagFilter();
  document.addEventListener("astro:page-load", applyTagFilter);
  document.addEventListener("DOMContentLoaded", applyTagFilter);
</script>

<style>
  .justified-gallery {
    --space: max(1.5vw, 8px);
    --scale: 0.5;
    --min-height-base: clamp(160px, 16vw, 320px);
    --min-height: calc(var(--min-height-base) * var(--scale));

    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
  }

  .justified-gallery a {
    flex-grow: calc(var(--width) * (100000 / var(--height)));
    flex-basis: min(
      calc(var(--min-height) * (var(--width) / var(--height))),
      100%
    );
    max-width: 100%;
    aspect-ratio: var(--width) / var(--height);
    overflow: hidden;
    opacity: 1;
    transition: all 0.05s ease-in-out;
  }

  .justified-gallery .grid-attribution {
    flex: 0 0 auto;
    align-self: flex-start;
    padding-top: 0;
    max-width: 100%;
  }

  .now-post.hidden {
    display: none;
  }

  .now-post.active > a span:nth-child(2) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1200px) {
    .justified-gallery a {
      flex-basis: calc((100% - var(--space)) / 2);
      max-width: calc((100% - var(--space)) / 2);
    }
  }

  @media (min-width: 1200px) {
    .justified-gallery {
      --scale: 0.42;
      --space: max(1vw, 7px);
    }
  }

  @media (min-width: 1536px) {
    .justified-gallery {
      --scale: 0.36;
      --space: max(1vw, 6px);
    }
  }

  @media (max-width: 600px) {
    .justified-gallery a {
      flex-basis: 100%;
      max-width: 100%;
    }
  }

  .justified-gallery a img {
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  .justified-gallery a:focus-visible {
    outline: 3px solid var(--outline);
    outline-offset: 2px;
    transform: scale(1.05);
    z-index: 1;
    border-radius: 2px;
    box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1);
  }

  .justified-gallery a.hidden {
    transition: opacity 0.4s ease-in-out;
    opacity: 0;
  }

  .justified-gallery::after {
    content: " ";
    flex-grow: 1000000000;
  }

  :global(.fancybox__thumbs) {
    display: none;
  }
</style>
